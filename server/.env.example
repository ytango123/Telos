# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional: per-request timeout in seconds (chapter generation can be slow)
# DEEPSEEK_HTTP_TIMEOUT=420

# Database
DATABASE_URL=sqlite+aiosqlite:///../data/telos.db

# Data paths
DATA_DIR=../data
UPLOAD_DIR=../data/uploads
VECTOR_DIR=../data/vectors

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
