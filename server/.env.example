# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional: per-request timeout in seconds (chapter generation can be slow)
# DEEPSEEK_HTTP_TIMEOUT=420

# Web Retrieval (Tavily + Jina Reader)
# Optional but recommended for better search recall
# TAVILY_API_KEY=tvly_xxx
# Optional: set if you use authenticated Jina Reader quota
# JINA_API_KEY=jina_xxx
# Debug mode switch (true/false)
# true: output detailed retrieval logs + local markdown dump in data/retrieval-debug
# false: disable all debug instrumentation in one switch
# RETRIEVAL_DEBUG_MODE=false

# GitHub Search (optional; unauthenticated allows 60 req/h per IP)
# GITHUB_TOKEN=ghp_xxx
# arXiv API base (override only if you mirror it)
# ARXIV_BASE_URL=http://export.arxiv.org/api/query

# Vision (GLM-4.6V-Flash via z.ai, free tier)
# ZAI_API_KEY=your_zai_api_key
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# ZAI_VISION_MODEL=glm-4.6v-flash

# Speech (DashScope qwen3-asr-flash for video fallback transcription)
# DASHSCOPE_API_KEY=sk-xxx
# DASHSCOPE_ASR_MODEL=qwen3-asr-flash
# Optional: Bilibili cookies file for yt-dlp subtitle fetch
# BILIBILI_COOKIES_FILE=path/to/cookies.txt

# RAG embedding (optional; speeds up Hugging Face model download)
# HF_TOKEN=hf_xxx

# Database
DATABASE_URL=sqlite+aiosqlite:///../data/telos.db

# Data paths
DATA_DIR=../data
UPLOAD_DIR=../data/uploads
VECTOR_DIR=../data/vectors

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
